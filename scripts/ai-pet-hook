#!/bin/sh

# Codex passes one JSON payload argument. Forward it quickly and never block Codex.
if [ "$#" -ge 1 ]; then
  printf '%s' "$1" | curl \
    --silent \
    --fail \
    --connect-timeout 0.2 \
    --max-time 1 \
    --header 'Content-Type: application/json' \
    --data-binary @- \
    http://127.0.0.1:17891/events \
    >/dev/null 2>&1 || true
fi

exit 0
